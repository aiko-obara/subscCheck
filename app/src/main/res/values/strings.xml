    <string name="detection_unknown_service">A service</string>

    <!-- Cancellation navigation -->
    <string name="cancel_url_copied">No browser found. The cancellation link was copied to your clipboard.</string>

    <!--
      主ボタンの下に必ず出す一文。ストアポリシー対策であると同時に、
      「押したら解約されると思った」という誤解を防ぐ UX でもある。
    -->
    <string name="cancel_disclaimer">The official site for %1$s will open. You need to complete the cancellation yourself.</string>
